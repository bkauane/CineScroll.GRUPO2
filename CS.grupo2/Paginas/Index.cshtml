@page
@model IndexModelos

<h1>🎬 Lista de Filmes</h1>

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Gênero</th>
            <th>Ano</th>
            <th>Avaliação</th>
        </tr>
    </thead>
    <tbody>
@foreach (var filme in Modelo.Filmes)
{
        <tr>
            <td>@filme.Titulo</td>
            <td>@filme.Genero</td>
            <td>@filme.Ano</td>
            <td>@filme.Avaliacao</td>
        </tr>
}
    </tbody>
</table>
